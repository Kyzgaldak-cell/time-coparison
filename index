<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Уақытты салыстыр!</title>
    <style>
        body {
            font-family: "Arial", sans-serif;
            text-align: center;
            background-color: #f4f4f4;
        }
        .container {
            background: white;
            width: 400px;
            margin: 50px auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2);
        }
        .question {
            font-size: 22px;
            margin-bottom: 20px;
        }
        .buttons button {
            padding: 10px;
            margin: 10px;
            font-size: 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            background: #4caf50;
            color: white;
        }
        #feedback {
            font-size: 20px;
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Уақытты салыстыр!</h1>
        <p class="question" id="questionText"></p>
        <div class="buttons">
            <button onclick="checkAnswer(this)"></button>
            <button onclick="checkAnswer(this)"></button>
        </div>
        <div id="feedback"></div>
    </div>
    <script>
        let times = [
            {name: "Әлия", time: 20},
            {name: "Сырым", time: 30},
            {name: "Айжан", time: 15},
            {name: "Медет", time: 25}
        ];
        let correctAnswer;

        function generateQuestion() {
            let indexes = [0, 1, 2, 3].sort(() => Math.random() - 0.5).slice(0, 2);
            let person1 = times[indexes[0]];
            let person2 = times[indexes[1]];
            
            correctAnswer = person1.time > person2.time ? person1.name : person2.name;
            document.getElementById("questionText").textContent = `${person1.name} – ${person1.time} мин, ${person2.name} – ${person2.time} мин. Кім көп уақыт жұмсады?`;
            
            let buttons = document.querySelectorAll(".buttons button");
            buttons[0].textContent = person1.name;
            buttons[1].textContent = person2.name;
        }

        function checkAnswer(button) {
            let feedback = document.getElementById("feedback");
            if (button.textContent === correctAnswer) {
                feedback.textContent = "✅ Дұрыс!";
                feedback.style.color = "green";
            } else {
                feedback.textContent = `❌ Қате! Дұрыс жауап: ${correctAnswer}`;
                feedback.style.color = "red";
            }
            setTimeout(generateQuestion, 2000);
        }

        generateQuestion();
    </script>
</body>
</html>
